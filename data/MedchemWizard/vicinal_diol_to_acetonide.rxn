# Bridge both free oxygens of a saturated vicinal diol with C(CH3)2.
# Forward-only analogue generation; no stereocentres are assigned.
name: "vicinal_diol_to_acetonide"
scaffold {
  smarts: "[OD1H1+0]-[CX4+0]-[CX4+0]-[OD1H1+0]"
  match_conditions {
    find_unique_embeddings: true
    ignore_symmetry_related_matches: true
  }
  unfix_implicit_hydrogens: [0, 3]
}
sidechain {
  id: 1
  reagent: "CC(C)"
  smarts: "CC(C)"
  join { a1: 0 a2: 1 btype: SS_SINGLE_BOND }
  join { a1: 3 a2: 1 btype: SS_SINGLE_BOND }
  match_conditions {
    max_matches_to_find: 1
  }
}
