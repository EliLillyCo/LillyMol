# Close an acyclic three-carbon arylamine chain onto an available ortho carbon.
name: "phenylpropylamine_to_tetrahydroquinoline"
scaffold {
  smarts: "[cD2H1]:[cD3]-[CH2D2R0]-[CH2D2R0]-[CH2D2R0]-[ND2H1R0+0]"
  match_conditions {
    find_unique_embeddings: true
    ignore_symmetry_related_matches: true
  }
  make_bond { a1: 0 a2: 5 btype: SS_SINGLE_BOND }
}
