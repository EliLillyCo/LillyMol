# Close Ar-CH2-CH2-NH-R at an available ortho carbon and unsaturate the chain.
# Retain the N substituent, including N-acyl and N-sulfonyl groups.
name: "phenethylamine_to_indole"
scaffold {
  smarts: "[cD2H1]:[cD3]-[CH2R0]-[CH2R0]-[ND2H1R0+0]"
  match_conditions {
    find_unique_embeddings: true
    ignore_symmetry_related_matches: true
  }
  make_bond { a1: 0 a2: 4 btype: SS_SINGLE_BOND }
  change_bond { a1: 2 a2: 3 btype: SS_DOUBLE_BOND }
}
