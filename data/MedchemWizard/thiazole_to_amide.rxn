# [*:1]c1ncc([*:2])s1 -> [*:1]C(=O)N[*:2]
# A non-fused 2,5-disubstituted thiazole, with an unsubstituted C4.
# Preserve C2/C5 attachment orientation and exclude extra ring substituents.
name: "thiazole_to_amide"
scaffold {
  smarts: "[*:1]-[cD3R1]1[nD2R1][cD2H1R1][cD3R1](-[*:2])[sD2R1]1"
  match_conditions {
    find_unique_embeddings: true
  }
  remove_atom: [1, 2, 3, 4, 6]
}
sidechain {
  id: 1
  reagent: "C(=O)N"
  smarts: "C(=O)N"
  join { a1: 0 a2: 0 }
  join { a1: 5 a2: 2 }
}
