# Retain the oxygen and C2 as O-CH3; remove only the unsubstituted C3.
# Unsubstituted C2/C3 and a two-ring fused system prevent substituent loss.
name: "benzofuran_to_anisole"
scaffold {
  smarts: "[/IWfss2cD3]1:[cD3]:[cD2H1R1]:[cD2H1R1]:[oD2R1+0]:1"
  match_conditions {
    find_unique_embeddings: true
    ignore_symmetry_related_matches: true
  }
  remove_atom: 2
  change_bond { a1: 0 a2: 4 btype: SS_SINGLE_BOND }
  change_bond { a1: 3 a2: 4 btype: SS_SINGLE_BOND }
}
