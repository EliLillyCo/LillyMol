# Open the C3-to-aryl bond, retaining oxygen and both chain carbons.
name: "dihydrobenzofuran_to_phenoxyethyl"
scaffold {
  smarts: "[cD3]1:[cD3]-[CD<4H>0R1+0]-[CH2D2R1]-[OD2R1+0]-1"
  match_conditions {
    find_unique_embeddings: true
    ignore_symmetry_related_matches: true
  }
  break_bond { a1: 1 a2: 2 }
  remove_chirality: 2
  unfix_implicit_hydrogens: 2
}
