# Remove either unsubstituted methylene bridge; keep distinct asymmetric openings.
name: "phthalan_to_benzyl_alcohol"
scaffold {
  smarts: "[cD3]1:[cD3]-[CH2D2R1]-[OD2R1+0]-[CH2D2R1]-1"
  match_conditions {
    find_unique_embeddings: false
    ignore_symmetry_related_matches: true
  }
  remove_atom: 4
}
