# Replace a free phenolic OH with a fused cyclic carbamate at an ortho C-H.
# Retain the phenolic oxygen; add C(=O)-NH between it and the ortho carbon.
name: "phenol_to_benzoxazolone"
scaffold {
  smarts: "[OD1H1+0]-[cD3]:[cD2H1]"
  match_conditions {
    find_unique_embeddings: true
    ignore_symmetry_related_matches: true
  }
  unfix_implicit_hydrogens: 0
}
sidechain {
  id: 1
  reagent: "C(=O)N"
  smarts: "C(=O)N"
  join { a1: 0 a2: 0 btype: SS_SINGLE_BOND }
  join { a1: 2 a2: 2 btype: SS_SINGLE_BOND }
  match_conditions { max_matches_to_find: 1 }
}
