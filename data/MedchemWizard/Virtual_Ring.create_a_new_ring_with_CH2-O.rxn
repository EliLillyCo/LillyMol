name: "Virtual_Ring.create_a_new_ring_with_CH2-O"
scaffold {
  id: 0
  smarts: "[/IWfss1aH]:[a]!@[/IWfss1a]:[cH]"
  match_conditions {
    find_unique_embeddings: true
    embeddings_can_overlap: false
  }
}
sidechain {
  id: 1
  smarts: "CO"
  reagent: "CO"
  join {
    a1: 0
    a2: 0
    btype: SS_SINGLE_BOND
  }
  join {
    a1: 3
    a2: 1
    btype: SS_SINGLE_BOND
  }
  match_conditions {
    find_unique_embeddings: true
    embeddings_can_overlap: true
    max_matches_to_find: 1
  }
}
