module(
    name = "lillymol",
    version = "1.2.0",
)

# Periodically check the bazel central registry for new versions.
# https://github.com/bazelbuild/bazel-central-registry/tree/main/modules

new_local_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:local.bzl", "new_local_repository")

#http_file = use_repo_rule(
#    "@bazel_tools//tools/build_defs/repo:http.bzl", "http_file"
#)
#http_archive = use_repo_rule(
#    "@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive"
#)


bazel_dep(name = "abseil-cpp", version = "20260817.0", repo_name="com_google_absl")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "caseyduquettesc_rules_python_pytest", version = "1.1.1", repo_name = "rules_python_pytest")
bazel_dep(name = "eigen", version = "5.0.1.bcr.1", repo_name="com_gitlab_libeigen_eigen")
bazel_dep(name = "gazelle", version = "0.54.0")

# Not being used.
#bazel_dep(name = "fast_float", version = "6.1.6")
bazel_dep(name = "fmt", version = "12.2.0")

bazel_dep(name = "google_benchmark", version = "1.9.5", repo_name="benchmark")
bazel_dep(name = "googletest", version = "1.18.0")
bazel_dep(name = "nanobind_bazel", version = "3.1.0")
bazel_dep(name = "onetbb", version = "2023.1.0", repo_name="onetbb")
bazel_dep(name = "platforms", version = "1.1.0")
# Version 27.0 works for c++, but does not work with python 3.11
bazel_dep(name = "protobuf", version = "36.2", repo_name="com_google_protobuf")
bazel_dep(name = "pybind11_bazel", version = "3.0.1")
# bazel_dep(name = "pybind11_protobuf", version = "2.11.1.bzl.3")
bazel_dep(name = "re2", version = "2025-11-05.bcr.1")
bazel_dep(name = "rules_cc", version = "0.2.26")
bazel_dep(name = "rules_go", version = "0.64.0")
# bazel_dep(name = "rules_proto_grpc_go", version = "5.0.1")

bazel_dep(name = "rules_pkg", version = "1.3.0")

bazel_dep(name = "rules_proto", version = "7.1.0")
# Beware, adding this version will cause a bump in the
# protoc version to an incompatible version.
bazel_dep(name = "rules_python", version = "2.4.2")

# bazel_dep(name = "rules_ruby", version = "0.20.1")
# bazel_dep(name = "simdjson", version = "4.6.0")
bazel_dep(name = "tomlplusplus", version = "3.4.0.bcr.1")
bazel_dep(name = "xxhash", version = "0.8.3.bcr.1")
bazel_dep(name = "zlib", version = "1.3.2")

# From Gemini.
# Register the Python versions you want to support
# run_python.sh checks the staged lib/lillymol.so.soabi file at runtime.

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(python_version = "3.11")
python.toolchain(python_version = "3.13")
python.toolchain(python_version = "3.12", is_default = True)
python.toolchain(python_version = "3.14")
use_repo(python, "python_3_11", "python_3_12", "python_3_13", "python_3_14")
# Can enable multiple versions if needed.
# use_repo(python, "python_3_11", "python_3_13")

# From Gemini
# If you find that rules_python isn't finding your uv versions automatically, you can
# "force" Bazel to look at your local installation in your MODULE.bazel while still
# using the toolchain system:
# python.toolchain(
#     python_version = "3.13",
#     # This tells Bazel: "Don't download it, use what I have here"
#     ignore_root_user_error = True, 
# )

# Local repositories

bazel_dep(name = "data", version = "1.0.0")
local_path_override(
    module_name = "data",
    path = "../data"
)

bazel_dep(name = "third_party", version = "1.0.0")
local_path_override(
    module_name = "third_party",
    path = "../third_party"
)

rules_python_config = use_extension("@rules_python//python/extensions:config.bzl", "config")
rules_python_config.explicit_init_py(default = True)

# Vendor provided tools, Lilly specific.

new_local_repository(
    name = "corina",
    path = "/lrlhps/apps/gc3tk/c3tk-core/lib/corina",
#   path = "/lrlhps/apps/corina/corina-5.0.0",
    build_file_content = """
load("@rules_cc//cc:defs.bzl", "cc_library")
cc_library(
    name = "corina",
    srcs = [
#      "lib/corina.so",
       "lib/libcorina_linux_rhel6_x86_64_libc2.12_gcc4.4.7.so",
    ],
    hdrs = ["include/corina_lib.h"],
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
)
""",
)

# Note that this includes a libf2c that might be different from @local_f2c.
# definitely possibility of problems...
new_local_repository(
    name = "biobyte",
    path= "/lrlhps/apps/gc3tk/c3tk-core/lib/biobyte/linux-64/",
    build_file_content = """
load("@rules_cc//cc:defs.bzl", "cc_library")
cc_library (
    name = "biobyte",
    srcs = [ "lib/libBB.a", "lib/libf2c.a" ],
    hdrs = glob(["h/*.h"]),
    strip_include_prefix = "h",
    visibility = ["//visibility:public"],
)
"""
)

new_local_repository(
  name = "nlopt",
  path = "/lrlhps/users/rx87690/third_party",
  build_file_content = """
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_proto_library", "cc_library", "cc_test")
cc_library(
  name = "nlopt",
  hdrs = [
    "include/nlopt.hpp",
    "include/nlopt.h",
  ],
  strip_include_prefix = "include",
  srcs = [
    "lib64/libnlopt.a",
  ],
    visibility = ["//visibility:public"],
)
"""
)
